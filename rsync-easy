#!/usr/bin/env bash
set -euo pipefail

# Gokberk Cinbis, May 2026

usage() {
    cat <<EOF
An easy-to-use rsync wrapper that accepts one or more remote paths, and copies them into a specified local directory.

Usage:
  ${0##*/} [user@]host[:port] remote_path [remote_path ...] local_dir

Arguments:
  [user@]host[:port]   Remote host, optional user and optional SSH port.
  remote_path          One or more remote files or directories to copy.
  local_dir            Local destination directory.

Examples:
  ${0##*/} hostname:8085 /home/localuser/Desktop/file.txt .
  ${0##*/} remoteuser@hostname:8085 /a /b /c ~/Downloads
  ${0##*/} hostname /home/localuser/Desktop/somedir ./tmp

Notes:
  - If user is omitted, the default user is used.
  - If port is omitted, SSH port 22 is used.
  - Quote remote paths that contain spaces.
EOF
}

default_user=`whoami`

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ $# -lt 3 ]]; then
    usage >&2
    exit 1
fi

target=$1
shift

user=""
host=""
port=""

# Match [user@]host[:port]
if [[ $target =~ ^(([^@]+)@)?([^:]+)(:([0-9]+))?$ ]]; then
    user=${BASH_REMATCH[2]:-$default_user}
    host=${BASH_REMATCH[3]}
    port=${BASH_REMATCH[5]:-22}
else
    echo "Invalid target format: $target" >&2
    echo "Expected: [user@]host[:port]" >&2
    exit 1
fi

remote="${user}@${host}"

# Last argument is the local destination
argc=$#
dest="${!argc}"

# All preceding arguments are remote source paths
sources=()
for ((i=1; i<argc; i++)); do
    arg="${!i}"
    sources+=("${remote}:${arg}")
done

mkdir -p -- "$dest"
echo rsync --progress -avzh -e \"ssh -p ${port}\" "${sources[@]}" "$dest"
rsync --progress -avzh -e "ssh -p ${port}" "${sources[@]}" "$dest"

