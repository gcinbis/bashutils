#!/usr/bin/env bash
set -euo pipefail

# Gokberk Cinbis and Perplexity, May 2026

default_user="$(whoami)"

usage() {
cat >&2 <<'USAGE'
Usage:
  rsync-easy --from [user@]host[:port] <remote-src>... <local-dest>
  rsync-easy --to   [user@]host[:port] <local-src>... <remote-dest>

Modes:
  --from   Copy from remote source path(s) to a local destination.
  --to     Copy from local source path(s) to a remote destination.

Examples:
  rsync-easy --from myhost /etc/hosts ./hosts
  rsync-easy --from alice@example.com:2222 /var/log/syslog ./syslog
  rsync-easy --to   myhost ./file.txt ./dir /tmp/upload/
  rsync-easy --to   alice@example.com:2222 ./build /srv/releases/

Notes:
  - The first argument must be either --from or --to.
  - The second argument must be in the form [user@]host[:port].
  - If user is omitted, defaults to current user ($(whoami)).
  - If port is omitted, the default SSH port is: 22.
USAGE
exit 1
}

(( $# >= 4 )) || usage

mode=$1
case "$mode" in
  --from|--to) ;;
  *)
    echo "First argument must be either --from or --to." >&2
    usage
    ;;
esac
shift

target=$1
shift

user=""
host=""
port=""

if [[ $target =~ ^(([^@]+)@)?([^:]+)(:([0-9]+))?$ ]]; then
  user=${BASH_REMATCH[2]:-$default_user}
  host=${BASH_REMATCH[3]}
  port=${BASH_REMATCH[5]:-22}
else
  echo "Invalid target format: $target" >&2
  echo "Expected: [user@]host[:port]" >&2
  exit 1
fi

remote="${user}@${host}"
argc=$#
final_path="${!argc}"

sources=()
for ((i=1; i<argc; i++)); do
  sources+=("${!i}")
done

(( ${#sources[@]} >= 1 )) || usage

cmd=(rsync -ah --info=progress2 --partial -e "ssh -p $port")

if [[ $mode == "--from" ]]; then
  for src in "${sources[@]}"; do
    cmd+=("${remote}:${src}")
  done
  cmd+=("$final_path")
else
  for src in "${sources[@]}"; do
    cmd+=("$src")
  done
  cmd+=("${remote}:${final_path}")
fi

exec "${cmd[@]}"
